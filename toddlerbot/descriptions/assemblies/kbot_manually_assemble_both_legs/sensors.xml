<mujoco>
  <sensor>
<!--    frame virtual sensors-->

    <framezaxis objtype="site" objname="imu_in_pelvis" name="upvector_pelvis"/>

    <framexaxis objtype="site" objname="imu_in_pelvis" name="forwardvector_pelvis"/>

    <framequat objtype="site" objname="imu_in_pelvis" name="orientation_pelvis"/>

    <framelinvel objtype="site" objname="imu_in_pelvis" name="global_linvel_pelvis"/>

    <frameangvel objtype="site" objname="imu_in_pelvis" name="global_angvel_pelvis"/>

    <framelinvel objtype="site" objname="left_foot" name="left_foot_global_linvel"/>
    <framelinvel objtype="site" objname="right_foot" name="right_foot_global_linvel"/>
    <framezaxis objtype="site" objname="left_foot" name="left_foot_upvector"/>
    <framezaxis objtype="site" objname="right_foot" name="right_foot_upvector"/>

<!--    IMU -->
    <velocimeter site="imu_in_pelvis" name="local_linvel_pelvis"/>
    <accelerometer site="imu_in_pelvis" name="accelerometer_pelvis"/>
    <gyro site="imu_in_pelvis" name="gyro_pelvis"/>

<!--    force sensor -->
    <force name="left_foot_force" site="left_foot"/>
    <force name="right_foot_force" site="right_foot"/>


<!--    contact sensor -->
    <contact name="left_foot_floor_found" geom1="left_foot_collision" geom2="floor" reduce="mindist" num="1" data="found"/>
    <contact name="right_foot_floor_found" geom1="right_foot_collision" geom2="floor" reduce="mindist" num="1" data="found"/>
    <contact name="right_foot_left_foot_found" geom1="right_foot_collision" geom2="left_foot_collision" reduce="mindist" num="1" data="found"/>
    <contact name="left_foot_right_shin_found" geom1="left_foot_collision" geom2="right_shin_collision" reduce="mindist" num="1" data="found"/>
    <contact name="right_foot_left_shin_found" geom1="right_foot_collision" geom2="left_shin_collision" reduce="mindist" num="1" data="found"/>
    <contact name="left_hand_left_thigh_found" geom1="left_hand_collision" geom2="left_thigh_collision" reduce="mindist" num="1" data="found"/>
    <contact name="right_hand_right_thigh_found" geom1="right_hand_collision" geom2="right_thigh_collision" reduce="mindist" num="1" data="found"/>

  </sensor>
</mujoco>