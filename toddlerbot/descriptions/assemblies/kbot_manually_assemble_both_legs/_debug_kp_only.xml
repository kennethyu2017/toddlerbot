<mujoco model="kbot_both_leg">
<!--  NOTE: for mjcf, the angle default is degree. -->
  <compiler angle="radian" meshdir="assets/"/>

  <!--for mjx -->
<!--    option/jacobian set to dense for GPU, sparse for TPU. -->
  <option iterations="3" ls_iterations="5" timestep=".002" integrator="Euler">
    <flag eulerdamp="disable"/>
  </option>

<!--  for mjx broadphase culling opt. ref shadow hand example.-->
  <custom>
    <numeric data="15" name="max_contact_points"/>
    <numeric data="15" name="max_geom_pairs"/>
  </custom>

  <!--  follow g1-->
  <default>
    <default class="both_leg">
<!--&lt;!&ndash;      kenneth: if we specify geom contact pairs explicitly, the contype/conaffinity filters, which-->
<!--  applied only to pairs generated by the body-pair mechanism, will be bypassed.  So we don't specify-->
<!--  contype/conaffinity to 1 for any collision class, even the body(except foot) contact against floor. &ndash;&gt;-->
<!--      condim=1 is Frictionless contact.-->
      <geom condim="1" contype="0" conaffinity="0"/>

      <!--joints-->
      <joint frictionloss=".1" damping="2"/>
<!--      <position inheritrange="1" kp="75"/>-->
<!--   inheritrange will Automatically set the actuator’s ctrlrange to match the transmission target’s range, i.e. the joint range. -->
      <position inheritrange="1" />

      <default class="RS04">
        <position kp="50" forcerange="-120 120" />
<!-- only set actuatorfrcrange when num_actuator:num_joint is not 1:1   -->
<!--        <joint armature=".025101925" actuatorfrcrange="-120 120" />-->
        <joint armature=".025101925" />

        <default class="hip_pitch_RS04">
          <joint axis="0 0 1" range="-1.0472 2.21657" />
        <!--   we set inheritrange above, so no need to set the ctrlrange here. -->
        <!--    <position ctrlrange="-1.0472 2.21657"  />-->
        </default>
        <default class="knee_pitch_RS04">
          <joint axis="0 0 1" range="0 2.70526"  />
        </default>

      </default>


      <default class="RS03">
        <position kp="35" forcerange="-60 60" />
        <joint armature=".01017752004" />

        <default class="hip_roll_RS03">
          <!--   we set inheritrange above, so no need to set the ctrlrange here. -->
        <!--    <position ctrlrange="-.20944 2.26893"  />-->
          <joint axis="0 0 1" range="-.20944 2.26893" />
        </default>
        <default class="hip_yaw_RS03">
          <joint axis="0 0 1" range="-1.53589 1.53589" />
        </default>

      </default>

      <default class="RS02">
        <position forcerange="-17 17" />
        <joint armature=".00321945" />

        <default class="ankle_pitch_RS02">
          <position kp="20"/>
          <joint axis="0 0 1" range="-.261799 1.13446" damping="1" />
        </default>
<!--        <default class="ankle_roll">-->
<!--          <position kp="2"/>-->
<!--          <joint axis="1 0 0" range="-.2618 .2618" actuatorfrcrange="-50 50" damping=".2" armature=".00721945"/>-->
<!--        </default>-->
      </default>

      <default class="visual">
        <!-- we use body/inertial element, so set geom density to zero.    -->
        <!-- compiler/inertiafromgeom default to auto: mujoco compiler will only infer mass and inertial from
         geom when the inertial element is missing in the body definition.-->
        <geom group="2" type="mesh" density="0" material="silver" rgba=".6 .03 .6 1"/>
      </default>
      <default class="collision">
        <!-- kenneth: we don' set contype/conaffinity to 1 to filter-out all body-pair contact check,
        including the contact with floor,
        to avoid un-necessary collision check, e.g., left_thigh with left_shin.
          instead, we only specify the contact geom pairs explicitly. -->
        <geom group="3" density="0" rgba=".2 1.0 .2  .3" />
<!--        <geom group="3" rgba=".2 1.0 .2 .3" contype="1" conaffinity="1" />-->
        <default class="foot">
          <geom size=".085 .03 .005"/>
        </default>
      </default>
      <site group="5" rgba="1 0 0 1"/>
    </default>
  </default>

